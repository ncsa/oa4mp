#! /usr/bin/env -S qdl-run
/*
   Run all local automated tests for OA4MP.
*/
  if['--help' ∈ args()]
then[
  say('all-local.qdl {-flow} {-local | -dev | -test} -- run all local automated tests.');
  say('-flow = optional switch to run the flow tests, which are interactive.');
  say('The flow tests take some little while to run and require you start the');
  say('NCSA VPN.');
  say('You may specify multiple test suites, but if you specify nothing, only local tests run.');
  return();
  ];
clc:=j_load('oa4mp.client.clc');

all_test_start:=date_ms();
do_flows := '-flow' ∈ args();
suites. := ['-dev', '-test', '-local']∈args();
test_counter.'pass' := 0;
test_counter.'fail' := 0;
test_counter.'skip' := 0;
if[suites.0][
    test_counter. += script_load('test#/cm-tests/all.qdl','cm_dev');
      if[do_flows]
    then[test_counter. += script_load('test#/dev/all.qdl');];
 ];

if[suites.1][
    test_counter. += script_load('test#/cm-tests/all.qdl','cm_test');
      if[do_flows]
    then[test_counter. += script_load('test#/test/all.qdl');];
 ];

   if[suites.2 || (true ∉ suites.)]
 then[
    test_counter. += script_load('test#/auto/tests/all.qdl');
    test_counter. += script_load('test#/auto/tests/rfc8693/all.qdl');
    test_counter. += script_load('test#/cm-tests/all.qdl');
      if[do_flows]
    then[test_counter. += script_load('test#/local/all.qdl');];
 ];
// print it nice
out.0 := 'All tests statistics:';
out.1 := ' Passed : ' + test_counter.'pass';
out.2 := ' Failed : ' + test_counter.'fail';
out.4 := 'Elapsed : ' + script_run('test#/utils/pp_elapsed.qdl', all_test_start);
say(print(out., {'show_keys' : false,'box':true}));
