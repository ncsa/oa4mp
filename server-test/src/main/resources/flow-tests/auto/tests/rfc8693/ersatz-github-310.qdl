#! /usr/bin/env -S qdl-run

/*
  Derivative ofersatz-rt-refresh, this tests that a provisioner with NO refresh
  token can provision an ersatz client that has them. Logically these should be
  independent.

  Note that since this has no refrehs token, the test can only be done with the
  access token for the exchange.
  */
/* for running in the QDL workspace manually
path := os_env('NCSA_DEV_INPUT')+'/oa4mp/server-test/src/main/resources/flow-tests';
script_path(path ~ script_path());
saved_cfg := '/tmp/ersatz1-test.json';
script_load('auto/tests/rfc8693/provisioner.qdl', saved_cfg, 'localhost:p-310');
clc#init($$OA4MP_CLC_XML_INI, 'localhost:e-310');
clc#read(saved_cfg , '-p'); // -p switch tell client that this is an ersatz client

tokens. := clc#exchange(); // does fork

*/

debugger(1);
args. := (0<size(args()))?args().0:['-subject', 'at']; // default is to use access token for exchange.
saved_cfg := '/tmp/ersatz1-test.json';
script_load('auto/tests/rfc8693/provisioner.qdl', saved_cfg, 'localhost:p-310');
clc#init($$OA4MP_CLC_XML_INI, 'localhost:e-310');
clc#read(saved_cfg , '-p'); // -p switch tell client that this is an ersatz client
old_tokens. := clc#tokens();
old_id. := clc#claims();
//say('claims:\n' + print(old_id.));
tokens. := clc#exchange('-rt', args.0, args.1); // forks flow
tokens. := clc#refresh();
say('ok: 𝕰𝖗s𝖆𝖙𝖟 GitHub issue 310 passed ' + (args.1) + ' for the subject token, followed by refresh');
