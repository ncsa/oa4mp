/*
   Use  -- for IGWN clients

   {"tokens": {"access": {
     "lifetime": 10800000,
     "qdl":  {
      "args":["igwn"],
      "load": "ligo/vo4/at.qdl",
      "xmd": {"exec_phase":   [
       "post_token",
       "post_exchange",
       "post_refresh"
      ]}
     },
     "type": "sci_token"
    }}}

*/
 debugger(1);

 debugger(1,'IGWN','starting init.');
       all_audience. := ['ANY', 'LIGO', 'segments.ligo.org'];
         robot_caput := 'igwn.robot:'; // marker in scopes for robots
  access_token.'ver' := 'scitoken:2.0';

 debugger(1,'IGWN', script_args()  + '=' + to_string(script_args(-1)));
 debugger(1,'IGWN','is_igwn=='+ is_igwn);

  ∄claims.'eppn' ⇒ err('Missing EPPN. Cannot determine scopes.', 'invalid_request');

           ζ.'Services:OSGPilotTest:SciTokens:scope_create' := ['scope_create'];
        ζ.'Services:OSGPilotTest:SciTokens:compute_create' := ['compute_create'];
        ζ.'Services:OSGPilotTest:SciTokens:compute_cancel' := ['compute_cancel'];
        ζ.'Services:OSGPilotTest:SciTokens:compute_modify' := ['compute_modify'];
          ζ.'Services:OSGPilotTest:SciTokens:compute_read' := ['compute_read'];

    if[is_igwn]
  then[
    // These are documented in https://git.ligo.org/computing/igwnscitokenscopes/-/blob/main/SciTokenScopes.json
                                                  all_audience. := ['ANY'];
    // The following are created with the extract.qdl script and pasted here.
    // It's the only way to be sure the policy document is actually processed right,
    // since doing it manually is a real error-prone chore.
                                                 ζ.'gw-astronomy:KAGRA-LIGO:members' ≔ ['read:/frames','read:/ligo','read:/kagra','read:/virgo','read:/shared','read:/staging','dqsegdb.read','gracedb.read','gwdatafind.read'];
                                          ζ.'Communities:LVC:LSC:LDG:CIT:LDGCITUsers' ≔ ['write:/staging/${uid}'];
                                         ζ.'Services:DQSegDB:SciTokens:scopes:create' ≔ ['dqsegdb.create'];
                                   ζ.'CO:COU:LDG Grid Account Holders:members:active' ≔ ['write:/staging/${uid}'];
                                   ζ.'Services:WLCG:SciTokens:scopes:read:authorized' ≔ ['compute.read'];
                                 ζ.'Services:WLCG:SciTokens:scopes:cancel:authorized' ≔ ['compute.cancel'];
                                 ζ.'Services:WLCG:SciTokens:scopes:create:authorized' ≔ ['compute.create'];
                                 ζ.'Services:WLCG:SciTokens:scopes:modify:authorized' ≔ ['compute.modify'];
                                ζ.'Services:DQSegDB:SciTokens:scopes:read:authorized' ≔ ['dqsegdb.read'];
                                ζ.'Services:GraceDB:SciTokens:scopes:read:authorized' ≔ ['gracedb.read'];
                                ζ.'Services:arrakis:SciTokens:scopes:read:authorized' ≔ ['arrakis.read'];
                               ζ.'Services:GraceDB:SciTokens:scopes:write:authorized' ≔ ['gracedb.write'];
                              ζ.'Services:DQSegDB:SciTokens:scopes:create:authorized' ≔ ['dqsegdb.create'];
                              ζ.'Services:DQSegDB:SciTokens:scopes:modify:authorized' ≔ ['dqsegdb.modify'];
                              ζ.'Services:arrakis:SciTokens:scopes:modify:authorized' ≔ ['arrakis.modify'];
                             ζ.'Services:gwDataFind:SciTokens:scopes:read:authorized' ≔ ['gwdatafind.read'];
                            ζ.'Services:XRootD:SciTokens:scopes:read-ligo:authorized' ≔ ['read:/ligo'];
                           ζ.'Services:XRootD:SciTokens:scopes:read-kagra:authorized' ≔ ['read:/kagra'];
                           ζ.'Services:XRootD:SciTokens:scopes:read-virgo:authorized' ≔ ['read:/virgo'];
                          ζ.'Services:GraceDB:SciTokens:scopes:create:cwb:authorized' ≔ ['gracedb.create:/events/cwb'];
                          ζ.'Services:GraceDB:SciTokens:scopes:create:mly:authorized' ≔ ['gracedb.create:/events/mly'];
                          ζ.'Services:XRootD:SciTokens:scopes:read-frames:authorized' ≔ ['read:/frames'];
                          ζ.'Services:XRootD:SciTokens:scopes:read-shared:authorized' ≔ ['read:/shared'];
                         ζ.'Services:GraceDB:SciTokens:scopes:create:gwak:authorized' ≔ ['gracedb.create:/events/gwak'];
                         ζ.'Services:GraceDB:SciTokens:scopes:create:mbta:authorized' ≔ ['gracedb.create:/events/mbta'];
                         ζ.'Services:GraceDB:SciTokens:scopes:create:sgnl:authorized' ≔ ['gracedb.create:/events/sgnl'];
                         ζ.'Services:XRootD:SciTokens:scopes:read-staging:authorized' ≔ ['read:/staging'];
                         ζ.'Services:XRootD:SciTokens:scopes:write-frames:authorized' ≔ ['write:/frames'];
                        ζ.'Services:GraceDB:SciTokens:scopes:create:pycbc:authorized' ≔ ['gracedb.create:/events/pycbc'];
                        ζ.'Services:GraceDB:SciTokens:scopes:create:pygrb:authorized' ≔ ['gracedb.create:/events/pygrb'];
                        ζ.'Services:GraceDB:SciTokens:scopes:create:spiir:authorized' ≔ ['gracedb.create:/events/spiir'];
                        ζ.'Services:SciTokenTesting:SciTokens:scopes:read:authorized' ≔ ['scitokentesting.read'];
                       ζ.'Services:GraceDB:SciTokens:scopes:create:aframe:authorized' ≔ ['gracedb.create:/events/aframe'];
                       ζ.'Services:GraceDB:SciTokens:scopes:create:gstlal:authorized' ≔ ['gracedb.create:/events/gstlal'];
                       ζ.'Services:SciTokenTesting:SciTokens:scopes:write:authorized' ≔ ['scitokentesting.write'];
                       ζ.'Services:arrakis:SciTokens:scopes:create:H0-DAQ:authorized' ≔ ['arrakis.create:/H0-DAQ'];
                       ζ.'Services:arrakis:SciTokens:scopes:create:H1-CAL:authorized' ≔ ['arrakis.create:/H1-CAL'];
                       ζ.'Services:arrakis:SciTokens:scopes:create:H1-DAQ:authorized' ≔ ['arrakis.create:/H1-DAQ'];
                       ζ.'Services:arrakis:SciTokens:scopes:create:L0-DAQ:authorized' ≔ ['arrakis.create:/L0-DAQ'];
                       ζ.'Services:arrakis:SciTokens:scopes:create:L1-CAL:authorized' ≔ ['arrakis.create:/L1-CAL'];
                       ζ.'Services:arrakis:SciTokens:scopes:create:L1-DAQ:authorized' ≔ ['arrakis.create:/L1-DAQ'];
                      ζ.'Services:arrakis:SciTokens:scopes:create:H1-lldd:authorized' ≔ ['arrakis.create:/H1-lldd'];
                      ζ.'Services:arrakis:SciTokens:scopes:create:K1-lldd:authorized' ≔ ['arrakis.create:/K1-lldd'];
                      ζ.'Services:arrakis:SciTokens:scopes:create:L1-lldd:authorized' ≔ ['arrakis.create:/L1-lldd'];
                      ζ.'Services:arrakis:SciTokens:scopes:create:V1-lldd:authorized' ≔ ['arrakis.create:/V1-lldd'];
                     ζ.'Services:GraceDB:SciTokens:scopes:create:external:authorized' ≔ ['gracedb.create:/events/external'];
                     ζ.'Services:arrakis:SciTokens:scopes:create:H1-nomad:authorized' ≔ ['arrakis.create:/H1-nomad'];
                     ζ.'Services:arrakis:SciTokens:scopes:create:H1-sgnax:authorized' ≔ ['arrakis.create:/H1-sgnax'];
                     ζ.'Services:arrakis:SciTokens:scopes:create:L1-nomad:authorized' ≔ ['arrakis.create:/L1-nomad'];
                     ζ.'Services:arrakis:SciTokens:scopes:create:L1-sgnax:authorized' ≔ ['arrakis.create:/L1-sgnax'];
                    ζ.'Services:arrakis:SciTokens:scopes:create:H1-sgninj:authorized' ≔ ['arrakis.create:/H1-sgninj'];
                    ζ.'Services:arrakis:SciTokens:scopes:create:L1-sgninj:authorized' ≔ ['arrakis.create:/L1-sgninj'];
                    ζ.'Services:arrakis:SciTokens:scopes:create:V1-sgninj:authorized' ≔ ['arrakis.create:/V1-sgninj'];
                   ζ.'Services:arrakis:SciTokens:scopes:create:H1-genesis:authorized' ≔ ['arrakis.create:/H1-genesis'];
                   ζ.'Services:arrakis:SciTokens:scopes:create:L1-genesis:authorized' ≔ ['arrakis.create:/L1-genesis'];
                  ζ.'Services:arrakis:SciTokens:scopes:create:H1-CALCLEAN:authorized' ≔ ['arrakis.create:/H1-CALCLEAN'];
                  ζ.'Services:arrakis:SciTokens:scopes:create:H1-sensemon:authorized' ≔ ['arrakis.create:/H1-sensemon'];
                  ζ.'Services:arrakis:SciTokens:scopes:create:L1-CALCLEAN:authorized' ≔ ['arrakis.create:/L1-CALCLEAN'];
                  ζ.'Services:arrakis:SciTokens:scopes:create:L1-sensemon:authorized' ≔ ['arrakis.create:/L1-sensemon'];
                ζ.'Services:arrakis:SciTokens:scopes:create:H1-lldd-LLPIC:authorized' ≔ ['arrakis.create:/H1-lldd-LLPIC'];
                ζ.'Services:arrakis:SciTokens:scopes:create:L1-lldd-LLPIC:authorized' ≔ ['arrakis.create:/L1-lldd-LLPIC'];
                ζ.'Services:arrakis:SciTokens:scopes:create:V1-lldd-LLPIC:authorized' ≔ ['arrakis.create:/V1-lldd-LLPIC'];
             ζ.'Services:arrakis:SciTokens:scopes:create:H1-lldd-O3Replay:authorized' ≔ ['arrakis.create:/H1-lldd-O3Replay'];
             ζ.'Services:arrakis:SciTokens:scopes:create:L1-lldd-O3Replay:authorized' ≔ ['arrakis.create:/L1-lldd-O3Replay'];
             ζ.'Services:arrakis:SciTokens:scopes:create:V1-lldd-O3Replay:authorized' ≔ ['arrakis.create:/V1-lldd-O3Replay'];
            ζ.'Services:arrakis:SciTokens:scopes:create:H1-arrakismetrics:authorized' ≔ ['arrakis.create:/H1-arrakismetrics'];
            ζ.'Services:arrakis:SciTokens:scopes:create:L1-arrakismetrics:authorized' ≔ ['arrakis.create:/L1-arrakismetrics'];
          ζ.'Services:arrakis:SciTokens:scopes:create:H1-CAL-O4E2E_202409:authorized' ≔ ['arrakis.create:/H1-CAL-O4E2E_202409'];
          ζ.'Services:arrakis:SciTokens:scopes:create:L1-CAL-O4E2E_202409:authorized' ≔ ['arrakis.create:/L1-CAL-O4E2E_202409'];
        ζ.'Services:arrakis:SciTokens:scopes:create:H1-nomad-O4E2E_202409:authorized' ≔ ['arrakis.create:/H1-nomad-O4E2E_202409'];
        ζ.'Services:arrakis:SciTokens:scopes:create:H1-sgnax-O4E2E_202409:authorized' ≔ ['arrakis.create:/H1-sgnax-O4E2E_202409'];
        ζ.'Services:arrakis:SciTokens:scopes:create:L1-nomad-O4E2E_202409:authorized' ≔ ['arrakis.create:/L1-nomad-O4E2E_202409'];
        ζ.'Services:arrakis:SciTokens:scopes:create:L1-sgnax-O4E2E_202409:authorized' ≔ ['arrakis.create:/L1-sgnax-O4E2E_202409'];
       ζ.'Services:arrakis:SciTokens:scopes:create:H1-sgninj-O4E2E_202409:authorized' ≔ ['arrakis.create:/H1-sgninj-O4E2E_202409'];
       ζ.'Services:arrakis:SciTokens:scopes:create:L1-sgninj-O4E2E_202409:authorized' ≔ ['arrakis.create:/L1-sgninj-O4E2E_202409'];
      ζ.'Services:arrakis:SciTokens:scopes:create:H1-genesis-O4E2E_202409:authorized' ≔ ['arrakis.create:/H1-genesis-O4E2E_202409'];
      ζ.'Services:arrakis:SciTokens:scopes:create:L1-genesis-O4E2E_202409:authorized' ≔ ['arrakis.create:/L1-genesis-O4E2E_202409'];
     ζ.'Services:arrakis:SciTokens:scopes:create:H1-CALCLEAN-O4E2E_202409:authorized' ≔ ['arrakis.create:/H1-CALCLEAN-O4E2E_202409'];
     ζ.'Services:arrakis:SciTokens:scopes:create:H1-sensemon-O4E2E_202409:authorized' ≔ ['arrakis.create:/H1-sensemon-O4E2E_202409'];
     ζ.'Services:arrakis:SciTokens:scopes:create:L1-CALCLEAN-O4E2E_202409:authorized' ≔ ['arrakis.create:/L1-CALCLEAN-O4E2E_202409'];
     ζ.'Services:arrakis:SciTokens:scopes:create:L1-sensemon-O4E2E_202409:authorized' ≔ ['arrakis.create:/L1-sensemon-O4E2E_202409'];

    ]
   else[
                              ζ.'gw-astronomy:KAGRA-LIGO:members' := ['read:/GraceDB', 'read:/frames','write:/GraceDB']; //CIL-1345, CIL-1427
                            ζ.'Communities:LVC:SegDB:SegDBWriter' := ['write:/DQSegDB'];
                         ζ.'Communities:LSCVirgoLIGOGroupMembers' := ['read:/DQSegDB' ,'read:/frames', 'read:/GraceDB','write:/GraceDB'];   //CIL-1345
             ζ.'Services:XRootD:SciTokens:read-frames:authorized' := ['read:/frames']; //CIL-1415
            ζ.'Services:XRootD:SciTokens:write-frames:authorized' := ['write:/frames']; //CIL-1414,
    ]; // end else

        get_permissions(γ.) -> reduce(@~,ζ\(γ\*\name));
         robots. := ~mask(scopes., 0 == starts_with(scopes., robot_caput));
      1 < size(robots.) ⇒ err('too many robots (' + size(robots.) +')','access_denied');

    is_robot := 1 == size(robots.);
    debugger(1,'is robot? ' + is_robot);

   // If there is no audience, use all_audience. Otherwise check if there is an override in tx_audience and use that.
    requested_audience. := (size(tx_audience.) == 0)?(size(audience.)==0?all_audience.:audience.):tx_audience.;

     // Scope setup.
    requested_scopes. := (0 < size(tx_scopes.))?tx_scopes.:scopes.;
